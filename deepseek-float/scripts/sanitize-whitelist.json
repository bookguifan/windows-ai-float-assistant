    "U", "S", "SUB", "SUP", "A", "IMG", "TABLE", "THEAD", "TBODY", "TR", "TD",
    "TH", "HR", "MARK", "SMALL", "DEL", "KBD", "FIGURE", "FIGCAPTION"
