# 项目级 npm/pnpm 配置
#
# registry：本机默认 registry 指向 mirrors.huaweicloud.com，下载大包时频繁
# UND_ERR_DESTROYED 断连；改用 npmmirror（实测 ~0.2s 响应）以保证依赖可复现安装。
registry=https://registry.npmmirror.com

# pnpm 9 从 .npmrc 读取布局配置，与 workspace 中的 hoisted 布局保持一致。
node-linker=hoisted

# 本机 Windows 未开启「开发者模式」，真实目录符号链接创建会失败，
# 因此关闭严苛的 peer 依赖校验，减少安装时的无谓报错。
strict-peer-dependencies=false

# 本机网络在并发拉取大文件时会 UND_ERR_DESTROYED 断连，压低并发提升成功率。
network-concurrency=3
fetch-retries=5
fetch-retry-maxtimeout=120000

# pnpm 11 默认会在安装前对 lockfile 做「供应链策略校验」：为每个条目逐个拉取
# 全量 metadata。本机网络下该步骤必然跑到 4 分钟后超时（ERR_PNPM_BROKEN_METADATA_JSON），
# 导致 pnpm install 永远失败。本项目依赖仅 vite / @tauri-apps/cli 两个公开主流包，
# 且 lockfile 由本仓库自行生成，故开启 trust-lockfile 跳过该校验。
trust-lockfile=true
